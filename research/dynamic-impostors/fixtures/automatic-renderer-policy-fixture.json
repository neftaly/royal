{
  "schema": "royal.research.dynamic-impostors.automatic-policy.v0",
  "date": "2026-06-29",
  "status": "research-only",
  "description": "CPU-only fixture for automatic renderer-private mesh LOD, billboard, and octahedral impostor policy. It deliberately avoids app-authored impostor nodes and per-object thresholds.",
  "apiBoundary": {
    "publicSceneShape": "ordinary asset instances plus renderer-produced visibility packets",
    "rendererPrivateOutputs": true,
    "publicRendererNodesAllowed": false,
    "publicPerObjectThresholdsAllowed": false
  },
  "capabilities": {
    "webgl2": {
      "instancing": true,
      "textureArrays": false,
      "fragmentDepth": false,
      "computeCulling": false,
      "path": "instanced-quad-impostors-with-page-table-textures"
    },
    "webgpu": {
      "instancing": true,
      "textureArrays": true,
      "storageBuffers": true,
      "computeCulling": true,
      "path": "storage-buffer-indirect-impostor-packets"
    }
  },
  "rendererPolicy": {
    "owner": "renderer-private",
    "source": [
      "sourceMeshes.bounds",
      "sourceMeshes.errorMetrics",
      "impostorAtlases.pageGroups",
      "materialTextureBudgets",
      "cameraPackets",
      "visibilityPackets"
    ],
    "selection": {
      "qualityTargetPixels": {
        "default": 4.0,
        "alpha-foliage": 4.0,
        "opaque-branch": 5.0
      },
      "cullProjectedDiameterBelowPixels": 2.0,
      "cullDistanceMeters": 920,
      "preferLowestCostWithinError": true
    },
    "hysteresis": {
      "screenErrorMarginFraction": 0.25,
      "holdFrames": 2,
      "cameraJitterPixels": 0.25
    },
    "transition": {
      "minCrossFadeFrames": 4,
      "mode": "renderer-dithered-alpha",
      "depthStable": true,
      "carryPreviousRepresentationDuringFade": true
    },
    "fallback": {
      "missingOctahedralPage": "billboard",
      "missingBillboardPage": "coarse-bounds-card",
      "skinnedOrAnimatedImpostor": "mesh-lod-only",
      "uncertainOcclusion": "draw-conservative-lower-priority"
    },
    "batching": {
      "maxDrawPacketsPerFrame": 8,
      "instancingKeys": [
        "representation",
        "atlasId",
        "materialClass",
        "depthPolicy"
      ]
    }
  },
  "materialTextureBudgets": {
    "physicalPageSlots": 4,
    "maxUploadsPerFrame": 2,
    "pageSize": 128,
    "bytesPerPage": 65536,
    "maxUploadBytesPerFrame": 131072,
    "fallbackQualityLabelsRequired": true
  },
