{
  "apiVersion": "royal.custom-shader-material.v0",
  "cases": [
    {
      "name": "portable-hologram-valid",
      "capabilities": "dualBackend",
      "expect": {
        "status": "custom",
        "codes": []
      },
      "descriptor": {
        "kind": "custom-shader-material",
        "id": "example:hologram-rim",
        "revision": "2026-06-29",
        "label": "Hologram Rim",
        "geometryTargets": ["box"],
        "fallback": {
          "kind": "unlit",
          "baseColor": {
            "kind": "solid",
            "color": [0.1, 0.35, 0.8, 1],
            "colorSpace": "srgb"
          }
        },
        "gates": {
          "backends": ["webgl2", "webgpu"],
          "features": ["texture-asset"],
          "limits": {
            "fragmentTextureUnits": 1
          }
        },
        "attributes": {
          "position": {
            "semantic": "position",
            "type": "vec3",
            "required": true
          },
          "normal": {
            "semantic": "normal",
            "type": "vec3",
            "required": true
          }
        },
        "uniforms": {
          "tint": {
            "type": "vec4",
            "default": [0.2, 0.72, 1, 1]
          },
          "pulse": {
            "type": "float",
            "default": 0.65
          },
          "baseColor": {
            "type": "texture2d",
            "default": {
              "kind": "solid",
              "color": [1, 1, 1, 1],
              "colorSpace": "srgb"
            }
          }
        },
        "runtimeUniforms": {
          "pulse": 0.25
        },
        "snippets": {
          "language": "royal-shader-v1",
          "portability": "webgl2-webgpu",
          "vertex": {
            "uses": ["position", "normal"],
            "outputs": {
              "worldNormal": "vec3"
            },
            "code": "let world = royal.model * vec4(attr.position, 1.0);\nout.worldNormal = normalize((royal.normalMatrix * vec4(attr.normal, 0.0)).xyz);\nreturn royal.viewProjection * world;"
          },
          "fragment": {
            "inputs": {
              "worldNormal": "vec3"
            },
            "code": "let rim = pow(1.0 - saturate(dot(normalize(in.worldNormal), royal.viewDir)), 2.0);\nlet lit = 0.35 + rim * uniforms.pulse;\nreturn vec4(uniforms.tint.rgb * lit, uniforms.tint.a);"
          }
        }
      }
    },
