          "tint": {
            "type": "vec4",
            "default": [1, 1, 1, 1]
          }
        },
        "snippets": {
          "language": "royal-shader-v1",
          "portability": "webgl2-webgpu",
          "vertex": {
            "uses": ["position", "tangent"],
            "outputs": {
              "tangentSign": "float"
            },
            "code": "out.tangentSign = attr.tangent.w;\nreturn royal.viewProjection * royal.model * vec4(attr.position, 1.0);"
          },
          "fragment": {
            "inputs": {
              "tangentSign": "float"
            },
            "code": "return vec4(uniforms.tint.rgb * in.tangentSign, uniforms.tint.a);"
          }
        }
