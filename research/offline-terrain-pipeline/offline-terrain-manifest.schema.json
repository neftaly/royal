{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://royal.local/research/offline-terrain-pipeline/offline-terrain-manifest.schema.json",
  "title": "Royal Offline Terrain Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifestVersion",
    "world",
    "tile",
    "lod",
    "meshes",
    "materialTextures",
    "previews",
    "provenance"
  ],
  "properties": {
    "manifestVersion": {
      "const": 1
    },
    "world": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "coordinateSystem", "units", "seed"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "coordinateSystem": { "$ref": "#/$defs/coordinateSystem" },
        "units": { "const": "meters" },
        "seed": { "type": "string", "minLength": 1 }
      }
    },
    "tile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "pageId",
        "bounds",
        "sizeMeters",
        "heightRangeMeters",
        "grid",
        "revision",
        "quality"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "pageId": { "type": "string", "minLength": 1 },
        "bounds": { "$ref": "#/$defs/bounds" },
        "sizeMeters": { "type": "number", "exclusiveMinimum": 0 },
        "heightRangeMeters": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "type": "number" }
        },
        "grid": {
          "type": "object",
          "additionalProperties": false,
          "required": ["x", "z", "level"],
          "properties": {
            "x": { "type": "integer" },
            "z": { "type": "integer" },
            "level": { "type": "integer", "minimum": 0 }
          }
        },
        "revision": { "type": "string", "minLength": 1 },
        "quality": { "enum": ["placeholder", "preview", "draft", "final"] }
      }
    },
    "lod": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identityPolicy", "levels"],
      "properties": {
        "identityPolicy": { "const": "stable-tile-page-revision" },
        "levels": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "level",
              "screenSpaceError",
              "mesh",
              "textures",
              "preview",
              "quality"
            ],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "level": { "type": "integer", "minimum": 0 },
              "screenSpaceError": { "type": "number", "minimum": 0 },
              "mesh": { "type": "string", "minLength": 1 },
              "textures": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1 }
              },
              "preview": { "type": "string", "minLength": 1 },
              "quality": { "enum": ["placeholder", "preview", "draft", "final"] }
            }
          }
        }
      }
    },
    "meshes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/artifact" }
    },
    "materialTextures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "allOf": [
          { "$ref": "#/$defs/artifact" },
          {
            "type": "object",
            "required": ["slot", "dimensions", "colorSpace"],
            "properties": {
              "slot": {
                "enum": ["albedo", "normal", "roughness", "height", "material-mask"]
              },
              "dimensions": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": { "type": "integer", "minimum": 1 }
              },
              "colorSpace": { "enum": ["srgb", "linear", "data"] }
            }
          }
        ]
      }
    },
    "previews": {
      "type": "array",
      "minItems": 1,
      "items": {
        "allOf": [
          { "$ref": "#/$defs/artifact" },
          {
            "type": "object",
            "required": ["role", "dimensions"],
            "properties": {
              "role": { "enum": ["thumbnail", "orbit-render", "debug-overlay", "contact-sheet"] },
              "dimensions": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": { "type": "integer", "minimum": 1 }
              }
            }
          }
        ]
      }
    },
    "reports": {
      "type": "array",
      "items": { "$ref": "#/$defs/artifact" }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recipe",
        "generator",
        "source",
        "inputsHash",
        "createdAt",
        "license"
      ],
      "properties": {
        "recipe": { "type": "string", "minLength": 1 },
        "generator": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version", "command"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "minLength": 1 },
            "command": { "type": "string", "minLength": 1 }
          }
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "uri", "revision"],
          "properties": {
            "kind": { "enum": ["procedural-node", "blender-scene", "infinigen-job", "fixture"] },
            "uri": { "type": "string", "minLength": 1 },
            "revision": { "type": "string", "minLength": 1 }
          }
        },
        "inputsHash": { "$ref": "#/$defs/sha256" },
        "createdAt": { "type": "string", "format": "date-time" },
        "machine": { "type": "string" },
        "license": { "type": "string", "minLength": 1 }
      }
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "required": [
        "id",
        "uri",
        "mediaType",
        "format",
        "bytes",
        "sha256",
        "revision",
        "quality"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "uri": { "type": "string", "minLength": 1 },
        "mediaType": { "type": "string", "minLength": 1 },
        "format": { "type": "string", "minLength": 1 },
        "bytes": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "revision": { "type": "string", "minLength": 1 },
        "quality": { "enum": ["placeholder", "preview", "draft", "final"] },
        "bounds": { "$ref": "#/$defs/bounds" },
        "vertexCount": { "type": "integer", "minimum": 0 },
        "indexCount": { "type": "integer", "minimum": 0 },
        "sourceStage": { "type": "string" }
      }
    },
    "bounds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min", "max"],
      "properties": {
        "min": { "$ref": "#/$defs/vector3" },
        "max": { "$ref": "#/$defs/vector3" }
      }
    },
    "coordinateSystem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["handedness", "up", "forward"],
      "properties": {
        "handedness": { "enum": ["right-handed", "left-handed"] },
        "up": { "enum": ["+Y", "+Z"] },
        "forward": { "enum": ["-Z", "+Z", "+Y"] }
      }
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "vector3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "type": "number" }
    }
  }
}
