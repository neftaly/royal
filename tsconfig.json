{
  "compilerOptions": {
    "target": "ES2022",
    "skipLibCheck": true,
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noUncheckedSideEffectImports": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "@royal/renderer-core": [
        "./packages/renderer-core/src/index.ts"
      ],
      "@royal/renderer-core/svg": [
        "./packages/renderer-core/src/svg-index.ts"
      ],
      "@royal/renderer-core/text": [
        "./packages/renderer-core/src/text/index.ts"
      ],
      "@royal/renderer-core/text/editable": [
        "./packages/renderer-core/src/text/editable/index.ts"
      ],
      "@royal/renderer-core/text/font": [
        "./packages/renderer-core/src/text/font.ts"
      ],
      "@royal/renderer-core/text/layout": [
        "./packages/renderer-core/src/text/layout.ts"
      ],
      "@royal/renderer-core/text/mesh": [
        "./packages/renderer-core/src/text/mesh.ts"
      ],
      "@royal/renderer-core/text/node": [
        "./packages/renderer-core/src/text/node.ts"
      ],
      "@royal/renderer-core/text/shaping": [
        "./packages/renderer-core/src/text/shaping.ts"
      ],
      "@royal/renderer-core/text/types": [
        "./packages/renderer-core/src/text/types.ts"
      ],
      "@royal/renderer-webgl": [
        "./packages/renderer-webgl/src/index.ts"
      ],
      "@royal/renderer-webgl/capabilities": [
        "./packages/renderer-webgl/src/capabilities.ts"
      ],
      "@royal/react": [
        "./packages/react/src/index.ts"
      ],
      "@royal/react/jsx-dev-runtime": [
        "./packages/react/src/jsx-dev-runtime.ts"
      ],
      "@royal/react/jsx-runtime": [
        "./packages/react/src/jsx-runtime.ts"
      ],
      "@royal/react/renderer/jsx-dev-runtime": [
        "./packages/react/src/renderer-jsx-dev-runtime.ts"
      ],
      "@royal/react/renderer/jsx-runtime": [
        "./packages/react/src/renderer-jsx-runtime.ts"
      ]
    },
    "isolatedModules": true,
    "jsx": "react-jsx",
    "noEmit": true,
    "types": [
      "node",
      "vitest/globals"
    ]
  },
  "include": [
    "apps/*/src",
    "packages/*/src",
    "packages/*/tests",
    "scripts/*.ts",
    "tests/*.ts",
    "tests/*.tsx",
    "vite.config.ts",
    "types/*.d.ts"
  ]
}
