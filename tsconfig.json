{
  "compilerOptions": {
    "target": "ES2022",
    "skipLibCheck": true,
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noUncheckedSideEffectImports": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "@royal/renderer-core": [
        "./packages/renderer-core/src/index.ts"
      ],
      "@royal/renderer-core/render-object": [
        "./packages/renderer-core/src/render-object.ts"
      ],
      "@royal/renderer-webgl": [
        "./packages/renderer-webgl/src/index.ts"
      ],
      "@royal/renderer-webgl/capabilities": [
        "./packages/renderer-webgl/src/capabilities.ts"
      ],
      "@royal/renderer-webgl/webxr": [
        "./packages/renderer-webgl/src/webxr.ts"
      ],
      "@royal/react": [
        "./packages/react/src/index.ts"
      ],
      "@royal/react/scene": [
        "./packages/react/src/scene.ts"
      ],
      "@royal/react/xr": [
        "./packages/react/src/xr.ts"
      ]
    },
    "isolatedModules": true,
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "noEmit": true,
    "types": [
      "node",
      "vitest/globals"
    ],
    "allowImportingTsExtensions": true
  },
  "include": [
    "apps/*/scripts/**/*.ts",
    "apps/*/src",
    "packages/*/src",
    "packages/*/tests",
    "research/projected-sphere-bounds/**/*.ts",
    "scripts/*.ts",
    "research/eon-rough-diffuse/*.ts",
    "tests/*.ts",
    "tests/*.tsx",
    "vite.config.ts",
    "types/*.d.ts"
  ]
}
