{
  "name": "royal",
  "private": true,
  "version": "0.0.20",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neftaly/royal.git"
  },
  "bugs": {
    "url": "https://github.com/neftaly/royal/issues"
  },
  "homepage": "https://github.com/neftaly/royal#readme",
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "bench:vt-pages": "node scripts/virtual-texture-page-perf.ts",
    "check:bundle-size": "node scripts/check-bundle-size.mjs",
    "check:bundle-size:details": "node scripts/check-bundle-size.mjs --details",
    "report:bundle-size": "node scripts/check-bundle-size.mjs --json",
    "check:vt-pages-build": "node scripts/virtual-texture-page-perf.ts --build-only",
    "check:package-consumer": "node scripts/package-consumer-smoke.mjs",
    "check:package-imports": "node scripts/package-import-smoke.mjs",
    "dev": "pnpm --filter @royal/examples-react dev",
    "lint": "pnpm -r --if-present lint",
    "quest:browser": "node scripts/quest-browser-control.mjs",
    "quest:telemetry": "node scripts/quest-telemetry.ts",
    "test": "vitest run tests/replacement/*.test.ts tests/replacement/*.test.tsx tests/tooling/*.test.ts tests/tooling/*.test.mjs apps/examples-react/scripts/*.test.mjs apps/examples-react/src/example-contract.test.ts apps/examples-react/src/examples/BenchmarkRendererSnapshot.test.ts && pnpm --filter @royal/examples-react check:gltf-lab-manifest",
    "typecheck": "tsc"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "three": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-glsl": "catalog:",
    "vitest": "catalog:"
  }
}
