{
  "name": "royal",
  "private": true,
  "version": "0.0.1",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neftaly/royal.git"
  },
  "bugs": {
    "url": "https://github.com/neftaly/royal/issues"
  },
  "homepage": "https://github.com/neftaly/royal#readme",
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "check:package-consumer": "node scripts/package-consumer-smoke.mjs",
    "check:package-imports": "node scripts/package-import-smoke.mjs",
    "check:gpu": "node scripts/gpu.ts check",
    "dev": "pnpm --filter @royal/examples-react dev",
    "dev:xr": "node scripts/dev-xr.mjs",
    "lint": "pnpm -r --if-present lint",
    "perf:vt-pages": "node scripts/virtual-texture-page-perf.ts",
    "quest:browser": "node scripts/quest-browser-control.mjs",
    "test": "vitest run tests/*.test.ts tests/*.test.tsx",
    "test:browser": "pnpm --filter @royal/examples-react test:browser",
    "typecheck": "tsc"
  },
  "devDependencies": {
    "@royal/renderer-webgl": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "react": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-glsl": "catalog:",
    "vitest": "catalog:"
  }
}
