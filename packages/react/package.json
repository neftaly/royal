{
  "name": "@royal/react",
  "version": "0.0.20",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neftaly/royal.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/neftaly/royal/issues"
  },
  "homepage": "https://github.com/neftaly/royal/tree/main/packages/react#readme",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./scene": {
      "types": "./dist/scene.d.ts",
      "import": "./dist/scene.js",
      "default": "./dist/scene.js"
    },
    "./xr": {
      "types": "./dist/xr.d.ts",
      "import": "./dist/xr.js",
      "default": "./dist/xr.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build --config ../../vite.config.ts --logLevel warn && tsc -p tsconfig.build.json",
    "lint": "oxlint --type-aware --deny-warnings -D eslint/prefer-arrow-callback -D eslint/func-style src",
    "prepack": "pnpm build",
    "test": "vitest run --root ../.. ../../tests/replacement/react-*.test.ts ../../tests/replacement/react-*.test.tsx"
  },
  "dependencies": {
    "@royal/renderer-core": "workspace:*",
    "@royal/renderer-webgl": "workspace:*"
  },
  "peerDependencies": {
    "react": "catalog:"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "react": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
