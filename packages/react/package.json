{
  "name": "@royal/react",
  "private": true,
  "version": "0.0.0",
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./jsx-runtime": "./src/jsx-runtime.ts",
    "./jsx-dev-runtime": "./src/jsx-dev-runtime.ts",
    "./renderer/jsx-runtime": "./src/renderer-jsx-runtime.ts",
    "./renderer/jsx-dev-runtime": "./src/renderer-jsx-dev-runtime.ts"
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "build": "vite build --config ../../vite.config.ts --logLevel warn && tsc -b tsconfig.build.json",
    "lint": "oxlint --type-aware --deny-warnings -D eslint/prefer-arrow-callback -D eslint/func-style",
    "test": "vitest run --root ../.. ../../tests/react-*.test.ts ../../tests/react-*.test.tsx"
  },
  "dependencies": {
    "@royal/renderer-core": "workspace:*",
    "@royal/renderer-webgl": "workspace:*",
    "react-reconciler": "0.33.0",
    "zustand": "^5.0.14"
  },
  "peerDependencies": {
    "react": "catalog:"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "@types/react-reconciler": "0.33.0",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "react": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
