{
  "extends": "../../tsconfig.build.json",
  "compilerOptions": {
    "composite": true,
    "isolatedDeclarations": true,
    "outDir": "dist",
    "paths": {
      "@royal/renderer-core": ["../renderer-core/dist/index.d.ts"],
      "@royal/renderer-core/render-object": ["../renderer-core/dist/render-object.d.ts"],
      "@royal/renderer-webgl": ["../renderer-webgl/dist/index.d.ts"],
      "@royal/renderer-webgl/capabilities": ["../renderer-webgl/dist/capabilities.d.ts"],
      "@royal/renderer-webgl/webxr": ["../renderer-webgl/dist/webxr.d.ts"]
    },
    "rootDir": "src",
    "tsBuildInfoFile": ".tsbuildinfo"
  },
  "include": ["src"],
  "references": [
    { "path": "../renderer-core/tsconfig.build.json" },
    { "path": "../renderer-webgl/tsconfig.build.json" }
  ]
}
