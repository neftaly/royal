{
  "name": "@royal/renderer-core",
  "private": true,
  "version": "0.0.0",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neftaly/royal.git",
    "directory": "packages/renderer-core"
  },
  "bugs": {
    "url": "https://github.com/neftaly/royal/issues"
  },
  "homepage": "https://github.com/neftaly/royal/tree/main/packages/renderer-core#readme",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=24.12.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./render-object": {
      "types": "./dist/render-object.d.ts",
      "import": "./dist/render-object.js",
      "default": "./dist/render-object.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "build": "vite build --config ../../vite.config.ts --logLevel warn && tsc -b tsconfig.build.json",
    "lint": "oxlint --type-aware --deny-warnings -D eslint/prefer-arrow-callback -D eslint/func-style",
    "prepack": "pnpm build",
    "test": "vitest run --root ../.. ../../tests/renderer-core-*.test.ts"
  },
  "devDependencies": {
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
