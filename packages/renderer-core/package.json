{
  "name": "@royal/renderer-core",
  "private": true,
  "version": "0.0.0",
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./text": "./src/text/index.ts",
    "./text/editable": "./src/text/editable/index.ts",
    "./text/font": "./src/text/font.ts",
    "./text/layout": "./src/text/layout.ts",
    "./text/mesh": "./src/text/mesh.ts",
    "./text/node": "./src/text/node.ts",
    "./text/shaping": "./src/text/shaping.ts",
    "./text/types": "./src/text/types.ts"
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "build": "vite build --config ../../vite.config.ts --logLevel warn && tsc -b tsconfig.build.json",
    "lint": "oxlint --type-aware --deny-warnings -D eslint/prefer-arrow-callback -D eslint/func-style",
    "test": "vitest run --root ../.. ../../tests/renderer-core-*.test.ts"
  },
  "devDependencies": {
    "@fontsource/atkinson-hyperlegible": "^5.2.8",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "earcut": "^3.0.2",
    "opentype.js": "^2.0.0",
    "wawoff2": "^2.0.1"
  }
}
