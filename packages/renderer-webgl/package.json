{
  "name": "@royal/renderer-webgl",
  "version": "0.0.1",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neftaly/royal.git",
    "directory": "packages/renderer-webgl"
  },
  "bugs": {
    "url": "https://github.com/neftaly/royal/issues"
  },
  "homepage": "https://github.com/neftaly/royal/tree/main/packages/renderer-webgl#readme",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=24.12.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./capabilities": {
      "types": "./dist/capabilities.d.ts",
      "import": "./dist/capabilities.js",
      "default": "./dist/capabilities.js"
    },
    "./webxr": {
      "types": "./dist/webxr.d.ts",
      "import": "./dist/webxr.js",
      "default": "./dist/webxr.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build --config ../../vite.config.ts --logLevel warn && tsc -b tsconfig.build.json --force",
    "lint": "oxlint --type-aware --deny-warnings -D eslint/prefer-arrow-callback -D eslint/func-style",
    "prepack": "pnpm build",
    "test": "vitest run --root ../.. ../../tests/renderer-webgl-*.test.ts"
  },
  "dependencies": {
    "@loaders.gl/core": "^4.4.3",
    "@loaders.gl/textures": "^4.4.3",
    "@royal/renderer-core": "workspace:*",
    "gl-matrix": "^3.4.4",
    "meshoptimizer": "^1.2.0",
    "minidraco": "^0.3.0"
  },
  "devDependencies": {
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
