{
  "name": "@royal/renderer-webgl",
  "version": "0.0.19",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neftaly/royal.git",
    "directory": "packages/renderer-webgl"
  },
  "bugs": {
    "url": "https://github.com/neftaly/royal/issues"
  },
  "homepage": "https://github.com/neftaly/royal/tree/main/packages/renderer-webgl#readme",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./ktx2": {
      "types": "./dist/ktx2.d.ts",
      "import": "./dist/ktx2.js",
      "default": "./dist/ktx2.js"
    },
    "./xr": {
      "types": "./dist/xr.d.ts",
      "import": "./dist/xr.js",
      "default": "./dist/xr.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build --config ../../vite.config.ts --logLevel warn && tsc -p tsconfig.build.json",
    "lint": "oxlint --type-aware --deny-warnings -D eslint/prefer-arrow-callback -D eslint/func-style src",
    "prepack": "pnpm build",
    "test": "vitest run --root ../.. ../../tests/replacement/renderer-webgl-*.test.ts"
  },
  "dependencies": {
    "@royal/renderer-core": "workspace:*",
    "meshoptimizer": "1.2.0",
    "minidraco": "catalog:"
  },
  "devDependencies": {
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
