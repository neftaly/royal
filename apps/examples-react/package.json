{
  "name": "@royal/examples-react",
  "private": true,
  "version": "0.0.0",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "build": "vite build --config vite.config.ts --logLevel warn",
    "dev": "vite --config vite.config.ts",
    "lint": "oxlint --type-aware --deny-warnings -D eslint/prefer-arrow-callback -D eslint/func-style",
    "preview": "vite preview --config vite.config.ts --host 127.0.0.1",
    "test": "pnpm exec vitest run --passWithNoTests --config vite.config.ts",
    "test:browser": "pnpm run build && node scripts/browser-smoke.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.19.3",
    "@royal/react": "workspace:*",
    "@royal/renderer-core": "workspace:*",
    "@royal/renderer-webgl": "workspace:*",
    "@tanstack/react-router": "^1.170.16",
    "flexily": "0.7.3",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
